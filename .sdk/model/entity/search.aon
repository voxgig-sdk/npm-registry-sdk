            json: "{\"operationId\":\"searchPackages\",\"parameters\":[{\"description\":\"Search query text\",\"example\":\"react\",\"in\":\"query\",\"name\":\"text\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"Number of results to return\",\"in\":\"query\",\"name\":\"size\",\"required\":false,\"schema\":{\"default\":20,\"maximum\":250,\"minimum\":1,\"type\":\"integer\"}},{\"description\":\"Offset for pagination\",\"in\":\"query\",\"name\":\"from\",\"required\":false,\"schema\":{\"default\":0,\"minimum\":0,\"type\":\"integer\"}},{\"description\":\"Weight for quality score (0.0 to 1.0)\",\"in\":\"query\",\"name\":\"quality\",\"required\":false,\"schema\":{\"default\":0.65,\"format\":\"float\",\"maximum\":1,\"minimum\":0,\"type\":\"number\"}},{\"description\":\"Weight for popularity score (0.0 to 1.0)\",\"in\":\"query\",\"name\":\"popularity\",\"required\":false,\"schema\":{\"default\":0.98,\"format\":\"float\",\"maximum\":1,\"minimum\":0,\"type\":\"number\"}},{\"description\":\"Weight for maintenance score (0.0 to 1.0)\",\"in\":\"query\",\"name\":\"maintenance\",\"required\":false,\"schema\":{\"default\":0.5,\"format\":\"float\",\"maximum\":1,\"minimum\":0,\"type\":\"number\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"objects\":{\"description\":\"Array of search result objects\",\"items\":{\"properties\":{\"package\":{\"properties\":{\"author\":{\"properties\":{\"email\":{\"description\":\"Person email\",\"format\":\"email\",\"type\":\"string\"},\"name\":{\"description\":\"Person name\",\"type\":\"string\"},\"url\":{\"description\":\"Person URL\",\"format\":\"uri\",\"type\":\"string\"}},\"type\":\"object\"},\"date\":{\"description\":\"Last publish date\",\"format\":\"date-time\",\"type\":\"string\"},\"description\":{\"description\":\"Package description\",\"type\":\"string\"},\"keywords\":{\"description\":\"Package keywords\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"links\":{\"properties\":{\"bugs\":{\"description\":\"Bug tracker URL\",\"format\":\"uri\",\"type\":\"string\"},\"homepage\":{\"description\":\"Package homepage URL\",\"format\":\"uri\",\"type\":\"string\"},\"npm\":{\"description\":\"NPM package page URL\",\"format\":\"uri\",\"type\":\"string\"},\"repository\":{\"description\":\"Repository URL\",\"format\":\"uri\",\"type\":\"string\"}},\"type\":\"object\"},\"maintainers\":{\"description\":\"Package maintainers\",\"items\":{\"properties\":{\"email\":{\"description\":\"Maintainer email\",\"format\":\"email\",\"type\":\"string\"},\"name\":{\"description\":\"Maintainer username\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"name\":{\"description\":\"Package name\",\"type\":\"string\"},\"publisher\":{\"properties\":{\"email\":{\"description\":\"Person email\",\"format\":\"email\",\"type\":\"string\"},\"name\":{\"description\":\"Person name\",\"type\":\"string\"},\"url\":{\"description\":\"Person URL\",\"format\":\"uri\",\"type\":\"string\"}},\"type\":\"object\"},\"version\":{\"description\":\"Latest version\",\"type\":\"string\"}},\"type\":\"object\"},\"score\":{\"properties\":{\"detail\":{\"properties\":{\"maintenance\":{\"description\":\"Maintenance score\",\"format\":\"float\",\"type\":\"number\"},\"popularity\":{\"description\":\"Popularity score\",\"format\":\"float\",\"type\":\"number\"},\"quality\":{\"description\":\"Quality score\",\"format\":\"float\",\"type\":\"number\"}},\"type\":\"object\"},\"final\":{\"description\":\"Final weighted score\",\"format\":\"float\",\"type\":\"number\"}},\"type\":\"object\"},\"searchScore\":{\"description\":\"Overall search score\",\"format\":\"float\",\"type\":\"number\"}},\"type\":\"object\"},\"type\":\"array\"},\"time\":{\"description\":\"Search execution timestamp\",\"format\":\"date-time\",\"type\":\"string\"},\"total\":{\"description\":\"Total number of results\",\"type\":\"integer\"}},\"type\":\"object\"}}},\"description\":\"Search results retrieved successfully\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"description\":\"Error type\",\"type\":\"string\"},\"reason\":{\"description\":\"Error reason\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Invalid search parameters\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
