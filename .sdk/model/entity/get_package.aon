\":\"object\"},\"description\":\"All versions of the package\",\"type\":\"object\"}},\"type\":\"object\"}}},\"description\":\"Package metadata retrieved successfully\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"description\":\"Error type\",\"type\":\"string\"},\"reason\":{\"description\":\"Error reason\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Package not found\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
